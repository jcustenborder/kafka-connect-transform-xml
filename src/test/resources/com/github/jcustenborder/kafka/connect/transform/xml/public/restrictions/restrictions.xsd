<!-- Modified for kafka-connect-transform-xml: minimized facets.xsd to zipCode
     and distance; changed distance from integer to int; added a required
     single-record wrapper and qualified local elements. See README.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://soapinterop.org/types"
           targetNamespace="http://soapinterop.org/types"
           elementFormDefault="qualified">
  <xs:simpleType name="zipCode">
    <xs:restriction base="xs:string">
      <xs:length value="5"/>
      <xs:pattern value="\d{5}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="distance">
    <xs:restriction base="xs:int">
      <xs:maxInclusive value="100" fixed="true"/>
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="measurement">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="myZipCode" type="tns:zipCode"/>
        <xs:element name="myDistance" type="tns:distance"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
