<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="scalars" type="ScalarRecord"/>
  <xs:complexType name="ScalarRecord">
    <xs:sequence>
      <xs:element name="text" type="xs:string" minOccurs="0"/>
      <xs:element name="flag" type="xs:boolean" minOccurs="0"/>
      <xs:element name="tiny" type="xs:byte" minOccurs="0"/>
      <xs:element name="small" type="xs:short" minOccurs="0"/>
      <xs:element name="number" type="xs:int" minOccurs="0"/>
      <xs:element name="large" type="xs:long" minOccurs="0"/>
      <xs:element name="single" type="xs:float" minOccurs="0"/>
      <xs:element name="doubleValue" type="xs:double" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string"/>
  </xs:complexType>
</xs:schema>
